{
  "name": "Teleprompter",
  "short_name": "Teleprompter",
  "description": "Teleprompter pessoal para gravar vídeos olhando para a câmera.",
  "lang": "pt-BR",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#0b0b0c",
